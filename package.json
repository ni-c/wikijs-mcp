{
  "name": "@ni-c/wikijs-mcp",
  "version": "0.1.2",
  "mcpName": "io.github.ni-c/wikijs-mcp",
  "description": "MCP server for Wiki.js: search, read and edit pages, and manage assets, users, groups and comments",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "wikijs",
    "wiki-js",
    "wiki",
    "documentation",
    "knowledge-base",
    "graphql"
  ],
  "license": "MIT",
  "author": "Willi Thiel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ni-c/wikijs-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/ni-c/wikijs-mcp/issues"
  },
  "homepage": "https://wikijs-mcp.ni-c.de",
  "funding": "https://github.com/sponsors/ni-c",
  "type": "module",
  "bin": {
    "wikijs-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "lint": "oxlint --deny-warnings && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run lint && npm test && npm run build",
    "assets": "svg-asset-set",
    "assets:check": "svg-asset-set --check",
    "docs:tools": "node scripts/gen-tools-doc.mjs",
    "docs:tools:check": "node scripts/gen-tools-doc.mjs --check"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "mcp-approval": "^0.4.0",
    "mcp-tool-allowlist": "^0.2.0",
    "undici": "^8.10.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "4.1.11",
    "oxlint": "^1.80.0",
    "prettier": "^3.9.6",
    "svg-asset-set": "https://github.com/ni-c/svg-asset-set/releases/download/v0.1.0/svg-asset-set-0.1.0.tgz",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
